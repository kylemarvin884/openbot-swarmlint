{
  "name": "openbot-swarmlint",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Turn a multi-agent event log into a coordination bill: who claimed what, who handed it back, and how much was talk versus work.",
  "keywords": [
    "agent",
    "multi-agent",
    "swarm",
    "cli",
    "observability",
    "coordination"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "swarmlint": "src/cli.mjs"
  },
  "files": [
    "src",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.mjs help",
    "demo": "node demo/demo.mjs",
    "test": "node --test"
  },
  "license": "MIT"
}
